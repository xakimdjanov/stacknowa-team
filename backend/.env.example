# ========================================================
# DATABASE CONFIGURATION (PostgreSQL + Sequelize)
# ========================================================
DB_NAME=hack
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432    
PORT=5000

# ========================================================
# JWT AUTHENTICATION
# ========================================================
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ========================================================
# AWS S3 / CLOUDFLARE R2 FILE STORAGE
# ========================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=your_s3_bucket_name
AWS_ENDPOINT=

# ========================================================
# INPAY PAYMENT GATEWAY (Uzbekistan Merchants)
# ========================================================
INPAY_MERCHANT_ID=your_inpay_merchant_id
INPAY_MERCHANT_TOKEN=your_inpay_merchant_token
INPAY_BASE_URL=https://inpay.uz/api/v1/
INPAY_CALLBACK_URL=http://localhost:5000/api/plans/inpay/webhook

# ========================================================
# AI EVALUATION PROVIDER (Google Gemini API)
# ========================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
