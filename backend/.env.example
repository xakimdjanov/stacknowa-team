# ========================================================
# DATABASE CONFIGURATION (PostgreSQL + Sequelize)
# ========================================================
DB_NAME=hack
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
PORT=5000

# ========================================================
# JWT AUTHENTICATION
# ========================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ========================================================
# AWS S3 / CLOUDFLARE R2 FILE STORAGE
# ========================================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=your_bucket_name
AWS_ENDPOINT=

# ========================================================
# INPAY PAYMENT GATEWAY (Uzbekistan Merchants)
# ========================================================
INPAY_MERCHANT_ID=
INPAY_MERCHANT_TOKEN=
INPAY_BASE_URL=https://inpay.uz/api/v1/
INPAY_CALLBACK_URL=http://localhost:5000/api/plans/inpay/webhook

# ========================================================
# AI EVALUATION PROVIDER (Google Gemini / OpenAI)
# ========================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ========================================================
# INITIAL DEFAULT ADMIN (Server ishga tushganda yaratiladi)
# ========================================================
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@gmail.uz
ADMIN_PASSWORD=admin12345
